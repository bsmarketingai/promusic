/* PRO MUSIC — EDU karusel „Imerzivní zvuk" */
.edu-sec .edu-intro{margin:-10px 0 30px;}
.edu-card{border:1px solid var(--border);border-radius:var(--pm-radius-xl);overflow:hidden;
  background:
    radial-gradient(80% 60% at 18% 0%, rgba(224,84,43,.10), transparent 60%),
    var(--surface);}
.edu-stage{position:relative;height:var(--h,520px);transition:height .5s var(--pm-ease);}
.edu-slide{position:absolute;inset:0;display:grid;grid-template-columns:1.05fr .95fr;gap:clamp(24px,4vw,56px);
  --ep:clamp(26px,4vw,52px);align-items:center;padding:var(--ep);
  opacity:0;visibility:hidden;transform:translateY(18px);
  transition:opacity .55s var(--pm-ease),transform .55s var(--pm-ease),visibility .55s;}
.edu-slide.is-active{opacity:1;visibility:visible;transform:none;}
.edu-text .eyebrow{margin-bottom:14px;}
.edu-text h3{font-family:var(--pm-font-display);font-weight:800;letter-spacing:-.03em;line-height:1.04;
  font-size:clamp(1.8rem,3.4vw,2.9rem);margin:0 0 16px;}
.edu-text p{color:var(--text-soft);font-size:clamp(1rem,1.25vw,1.15rem);line-height:1.62;margin:0;max-width:46ch;}
.edu-facts{display:flex;gap:26px;flex-wrap:wrap;margin-top:24px;}
.edu-fact{display:flex;flex-direction:column;gap:3px;}
.edu-fact b{font-family:var(--pm-font-display);font-weight:800;letter-spacing:-.02em;font-size:clamp(1.5rem,2.4vw,2.1rem);color:var(--accent);line-height:1;}
.edu-fact span{font-family:var(--pm-font-mono);font-size:11px;letter-spacing:.04em;color:var(--text-mute);text-transform:uppercase;}
.edu-art{position:relative;border-radius:max(8px, calc(var(--pm-radius-xl) - var(--ep)));overflow:hidden;
  background:radial-gradient(70% 70% at 50% 30%, rgba(224,84,43,.08), transparent 70%), #0c0b09;
  border:1px solid var(--border);aspect-ratio:4/3;display:flex;align-items:center;justify-content:center;padding:18px;}
.edu-art svg{width:100%;height:100%;}

.edu-nav{display:flex;align-items:center;gap:14px;padding:14px clamp(18px,3vw,28px);
  border-top:1px solid var(--border);background:rgba(7,6,5,.4);}
.edu-arrow{flex:none;width:44px;height:44px;border-radius:50%;border:1px solid var(--border-strong);
  background:transparent;color:var(--text);font-size:20px;cursor:pointer;transition:all var(--pm-dur) var(--pm-ease);
  display:flex;align-items:center;justify-content:center;}
.edu-arrow:hover{border-color:var(--accent);color:var(--accent);}
.edu-tabs{flex:1;display:flex;gap:8px;overflow-x:auto;overflow-y:visible;scrollbar-width:none;padding:22px 2px;margin:-22px 0;}
.edu-tabs::-webkit-scrollbar{display:none;}
.edu-tab{flex:none;position:relative;display:inline-flex;align-items:center;gap:8px;white-space:nowrap;cursor:pointer;
  font-family:var(--pm-font-mono);font-size:12px;color:var(--text-soft);
  background:transparent;border:1px solid var(--border-strong);border-radius:var(--pm-radius-pill);padding:8px 14px;
  transition:color var(--pm-dur) var(--pm-ease),background var(--pm-dur) var(--pm-ease);}
.edu-tab::before{content:"";position:absolute;inset:0;border-radius:inherit;padding:1.5px;
  background:radial-gradient(70px 70px at var(--mx,50%) var(--my,50%),var(--accent-bright,#f2693f),var(--accent) 38%,rgba(224,84,43,0) 78%);
  -webkit-mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);
  -webkit-mask-composite:xor;mask-composite:exclude;opacity:0;transition:opacity var(--pm-dur) var(--pm-ease);pointer-events:none;}
.edu-tab .et-n{color:var(--text-mute);font-weight:700;}
.edu-tab:hover{border-color:transparent;color:var(--text);background:var(--accent-tint);box-shadow:0 0 22px rgba(224,84,43,.4);}
.edu-tab:hover::before{opacity:1;}
.edu-tab.is-active{background:var(--accent);border-color:var(--accent);color:var(--on-accent);}
.edu-tab.is-active::before{opacity:0;}
.edu-tab.is-active .et-n{color:rgba(255,255,255,.7);}

@media(max-width:860px){
  .edu-card{border-radius:var(--pm-radius-lg);}
  .edu-stage{height:auto !important;}
  .edu-slide{position:relative;display:none;opacity:1;visibility:visible;transform:none;
    grid-template-columns:1fr;align-content:start;gap:20px;padding:24px 20px;}
  .edu-slide.is-active{display:grid;}
  .edu-art{aspect-ratio:16/11;order:-1;border-radius:max(8px, calc(var(--pm-radius-lg) - 20px));}
  .edu-text h3{font-size:1.5rem;}
  .edu-text p{font-size:1rem;max-width:none;}
  .edu-facts{gap:18px;margin-top:18px;}
  .edu-fact b{font-size:1.5rem;}
  /* nav: šipky + scrollovatelné záložky s popiskem */
  .edu-nav{gap:8px;padding:12px 14px;}
  .edu-tab{font-size:11px;padding:8px 12px;}
  .edu-tabs{padding:16px 2px;margin:-16px 0;scroll-snap-type:x proximity;}
  .edu-tab{scroll-snap-align:center;}
}
@media(max-width:430px){
  .edu-arrow{display:none;}
  .edu-text h3{font-size:1.35rem;}
  .edu-facts{gap:14px;}
}
@media(prefers-reduced-motion:reduce){
  .edu-stage{height:auto !important;}
  .edu-slide{position:relative;opacity:1;visibility:visible;transform:none;border-bottom:1px solid var(--border);}
  .edu-slide:last-child{border-bottom:0;}
}
