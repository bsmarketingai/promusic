/* PRO MUSIC — EDU karusel „Imerzivní zvuk" (vysvětlující infografika + text).
   Renderuje se do #eduImmersive. Sdílené; běží na všech stránkách, kde sekce existuje. */
(function () {
  var mount = document.getElementById("eduImmersive");
  if (!mount) return;

  var slides = [
    {
      tag: "Co to je",
      title: "Imerzivní zvuk",
      lead: "Zvuk, který přichází odevšud — ne jen zleva a zprava. Místo dvou kanálů (stereo) se každý nástroj, hlas i efekt umístí do prostoru jako samostatný objekt. Posluchač je uvnitř scény, ne před ní.",
      facts: [["360°", "zvukové pole"], ["3D", "objektový mix"], ["1:1", "obraz = zvuk"]],
      art: artObjects()
    },
    {
      tag: "Jak to funguje",
      title: "Objektově orientovaný zvuk",
      lead: "Zvukař neposílá zvuk do konkrétních reproduktorů, ale řekne procesoru, kde má nástroj znít. Systém pak v reálném čase rozpočítá signál mezi desítky reproduktorů tak, aby zdroj vznikl přesně v daném bodě — i v pohybu.",
      facts: [["L-ISA", "Processor"], ["≥7", "frontových pozic"], ["96 kHz", "real-time"]],
      art: artRoom()
    },
    {
      tag: "Proč je to lepší",
      title: "Každý slyší stejně dobře",
      lead: "U klasického sterea sedí ideální poslech jen pár lidí uprostřed. Imerzivní systém rozprostře čitelnost a hloubku do celého hlediště — srozumitelnost řeči, oddělení nástrojů a lokalizace fungují i z kraje řady.",
      facts: [["+", "srozumitelnost"], ["0", "hluchých míst"], ["=", "zážitek všude"]],
      art: artCompare()
    },
    {
      tag: "Technologie",
      title: "L-ISA &amp; L-Acoustics Ambiance",
      lead: "L-ISA staví živý objektový mix. Ambiance dodá virtuální akustiku — sál se elektronicky protáhne z činohry do koncertního dozvuku bez jediného stavebního zásahu. Návrh ladíme v SoundVision a měříme přes Smaart.",
      facts: [["L-ISA", "live objekty"], ["Ambiance", "virtuální dozvuk"], ["SoundVision", "3D simulace"]],
      art: artTech()
    },
    {
      tag: "V praxi",
      title: "Schéma imerzivního sálu",
      lead: "Frontová scéna z 5–9 sloupů pokrývá šířku jeviště, boční a zadní reproduktory uzavřou prostor okolo publika, stropní vrstva dotvoří výšku. Vše řídí jeden procesor — a celé to navrhneme, nainstalujeme a vyladíme na klíč.",
      facts: [["5–9", "frontových sloupů"], ["L+R+S", "surround vrstvy"], ["na klíč", "návrh → servis"]],
      art: artLayout()
    }
  ];

  var i = 0, timer = null, DUR = 8000;

  var html =
    '<div class="wrap">' +
    '<div class="sec-head"><span class="idx">02·</span><h2>Rozumíme imerzivnímu zvuku</h2><span class="rule"></span></div>' +
    '<p class="sec-lead edu-intro">Než se rozhodnete, vysvětlíme, o co jde. Projděte si, co je imerzivní zvuk, jak funguje a proč mění zážitek v sále.</p>' +
    '<div class="edu-card">' +
      '<div class="edu-stage">' +
        slides.map(function (s, n) {
          return '<article class="edu-slide' + (n === 0 ? " is-active" : "") + '" data-n="' + n + '">' +
            '<div class="edu-text"><span class="eyebrow">' + s.tag + '</span>' +
            '<h3>' + s.title + '</h3>' +
            '<p>' + s.lead + '</p>' +
            '<div class="edu-facts">' + s.facts.map(function (f) {
              return '<div class="edu-fact"><b>' + f[0] + '</b><span>' + f[1] + '</span></div>';
            }).join("") + '</div></div>' +
            '<div class="edu-art">' + s.art + '</div>' +
          '</article>';
        }).join("") +
      '</div>' +
      '<div class="edu-nav">' +
        '<button class="edu-arrow edu-prev" aria-label="Předchozí">‹</button>' +
        '<div class="edu-tabs">' + slides.map(function (s, n) {
          return '<button class="edu-tab' + (n === 0 ? " is-active" : "") + '" data-n="' + n + '"><span class="et-n">0' + (n + 1) + '</span>' + s.tag + '</button>';
        }).join("") + '</div>' +
        '<button class="edu-arrow edu-next" aria-label="Další">›</button>' +
      '</div>' +
    '</div></div>';

  mount.innerHTML = html;

  var stage = mount.querySelector(".edu-stage");
  var slidesEl = [].slice.call(mount.querySelectorAll(".edu-slide"));
  var tabs = [].slice.call(mount.querySelectorAll(".edu-tab"));

  function go(n) {
    i = (n + slidesEl.length) % slidesEl.length;
    slidesEl.forEach(function (el, k) { el.classList.toggle("is-active", k === i); });
    tabs.forEach(function (el, k) { el.classList.toggle("is-active", k === i); });
    stage.style.setProperty("--h", slidesEl[i].scrollHeight + "px");
    // posunout pás záložek tak, aby aktivní byla vidět (vystředit)
    var wrap = tabs[i] && tabs[i].parentElement;
    if (wrap) {
      var t = tabs[i];
      var target = t.offsetLeft - (wrap.clientWidth - t.offsetWidth) / 2;
      wrap.scrollTo({ left: Math.max(0, target), behavior: "smooth" });
    }
  }
  function start() { stop(); timer = setInterval(function () { go(i + 1); }, DUR); }
  function stop() { if (timer) { clearInterval(timer); timer = null; } }
  var userStopped = false;
  function userStop() { userStopped = true; stop(); }

  tabs.forEach(function (t) {
    t.addEventListener("pointermove", function (e) {
      var r = t.getBoundingClientRect();
      t.style.setProperty("--mx", ((e.clientX - r.left) / r.width * 100).toFixed(1) + "%");
      t.style.setProperty("--my", ((e.clientY - r.top) / r.height * 100).toFixed(1) + "%");
    });
    t.addEventListener("click", function () { userStop(); go(+t.getAttribute("data-n")); });
  });
  mount.querySelector(".edu-prev").addEventListener("click", function () { userStop(); go(i - 1); });
  mount.querySelector(".edu-next").addEventListener("click", function () { userStop(); go(i + 1); });
  mount.addEventListener("pointerenter", function () { if (!userStopped) stop(); });
  mount.addEventListener("pointerleave", function () { if (!userStopped) start(); });

  // výška + autoplay až je sekce vidět
  function sync() { stage.style.setProperty("--h", slidesEl[i].scrollHeight + "px"); }
  window.addEventListener("resize", sync);
  setTimeout(sync, 60); setTimeout(sync, 400);
  var io = new IntersectionObserver(function (es) {
    es.forEach(function (e) { if (e.isIntersecting) { sync(); if (!userStopped) start(); } else stop(); });
  }, { threshold: 0.25 });
  io.observe(mount);

  /* ===== infografiky (inline SVG, brand barvy) ===== */
  function artObjects() {
    var src = [[160,46,"S1"],[244,86,"S2"],[252,162,"S3"],[160,200,"S4"],[68,162,"S5"],[76,86,"S6"]];
    return bp('PŘÍMÝ ZVUK · OBJEKTOVÉ POLE', 'DWG-01',
      ring(160, 124, 92) + ring(160, 124, 60) +
      '<rect x="150" y="114" width="20" height="20" fill="none" stroke="#f2693f" stroke-width="1.3"/>' +
      '<line x1="150" y1="124" x2="170" y2="124" stroke="#f2693f" stroke-width=".6"/><line x1="160" y1="114" x2="160" y2="134" stroke="#f2693f" stroke-width=".6"/>' +
      leader(196, 124, 230, 124, 'POSLUCHAČ (ref.)') +
      src.map(function (p) {
        return dash(160, 124, p[0], p[1]) +
          '<rect x="' + (p[0]-9) + '" y="' + (p[1]-9) + '" width="18" height="18" fill="rgba(224,84,43,.12)" stroke="#e0542b" stroke-width="1.1"/>' +
          '<line x1="' + (p[0]-9) + '" y1="' + (p[1]-9) + '" x2="' + (p[0]+9) + '" y2="' + (p[1]+9) + '" stroke="#e0542b" stroke-width=".5"/>' +
          '<text x="' + p[0] + '" y="' + (p[1]-13) + '" text-anchor="middle" font-size="7.5" fill="#a39d90" font-family="monospace">' + p[2] + '</text>';
      }).join("") +
      '<text x="160" y="232" text-anchor="middle" font-size="7.5" fill="#7d7669" font-family="monospace">Ø = lokalizace 360° · 6 zdrojů</text>'
    );
  }
  function artRoom() {
    var spk = "", dim = "";
    for (var k = 0; k < 7; k++) {
      var x = 48 + k * 36;
      spk += spkr(x, 44) + '<line x1="' + (x+8) + '" y1="62" x2="' + (x+8) + '" y2="150" stroke="#e0542b" stroke-width=".5" stroke-dasharray="2 3"/>' + tick(x+8, 150);
      spk += '<text x="' + (x+8) + '" y="38" text-anchor="middle" font-size="6.5" fill="#a39d90" font-family="monospace">L' + (k+1) + '</text>';
    }
    return bp('FRONTOVÁ SCÉNA · PŮDORYS', 'DWG-02',
      // dimension line
      dimline(48, 28, 264, 28, '7 × 1500 mm') +
      spk +
      '<rect x="36" y="158" width="248" height="62" fill="none" stroke="rgba(236,230,218,.2)" stroke-width="1" stroke-dasharray="4 3"/>' +
      '<text x="160" y="192" text-anchor="middle" font-size="9" fill="#a39d90" font-family="monospace" letter-spacing="2">PUBLIKUM</text>' +
      leader(264, 53, 292, 70, 'L-Acoustics') +
      '<text x="160" y="236" text-anchor="middle" font-size="7.5" fill="#7d7669" font-family="monospace">rozteč pozic = konstantní krytí šíře jeviště</text>'
    );
  }
  function artCompare() {
    return bp('STEREO vs. IMERZIVNÍ · KRYTÍ', 'DWG-03',
      '<line x1="160" y1="34" x2="160" y2="214" stroke="rgba(236,230,218,.16)" stroke-dasharray="3 4"/>' +
      '<text x="84" y="44" text-anchor="middle" font-size="8" fill="#a39d90" font-family="monospace">STEREO · 2.0</text>' +
      spkr(48, 52) + spkr(106, 52) +
      '<path d="M62 130 Q84 78 112 78 Q140 78 154 130 Z" fill="rgba(224,84,43,.08)" stroke="#e0542b" stroke-width="1" stroke-dasharray="3 3"/>' +
      '<text x="92" y="108" text-anchor="middle" font-size="7" fill="#f2693f" font-family="monospace">sweet spot</text>' +
      '<rect x="78" y="150" width="14" height="14" fill="none" stroke="#f2693f" stroke-width="1.2"/>' +
      '<circle cx="50" cy="176" r="3" fill="none" stroke="rgba(236,230,218,.35)"/><circle cx="120" cy="178" r="3" fill="none" stroke="rgba(236,230,218,.35)"/>' +
      '<text x="240" y="44" text-anchor="middle" font-size="8" fill="#f2693f" font-family="monospace">IMERZIVNÍ · 7.x</text>' +
      [184,206,228,250,272,294].map(function (x){return spkr(x-5,52);}).join("") +
      '<path d="M178 150 Q240 96 302 150 L302 168 Q240 120 178 168 Z" fill="rgba(224,84,43,.14)" stroke="#e0542b" stroke-width="1"/>' +
      [196,222,248,274].map(function (x){return '<rect x="' + (x-6) + '" y="' + (150+((x%48)?4:-2)) + '" width="12" height="12" fill="none" stroke="#f2693f" stroke-width="1.1"/>';}).join("") +
      '<text x="240" y="206" text-anchor="middle" font-size="7" fill="#4fae6e" font-family="monospace">rovnoměrné krytí celého hlediště</text>'
    );
  }
  function artTech() {
    var items = [["L-ISA","Objektový live mix","≤ 96 obj."],["AMBIANCE","Virtuální akustika","el. dozvuk"],["SOUNDVISION","3D simulace","predikce SPL"],["SMAART","Měření & ladění","FFT / RTA"]];
    return bp('SIGNÁLOVÝ ŘETĚZEC · SCHÉMA', 'DWG-04',
      '<line x1="40" y1="56" x2="40" y2="206" stroke="#e0542b" stroke-width=".6" stroke-dasharray="2 3"/>' +
      items.map(function (it, k) {
        var y = 44 + k * 42;
        return '<line x1="40" y1="' + (y+15) + '" x2="56" y2="' + (y+15) + '" stroke="#e0542b" stroke-width=".6"/>' +
          '<rect x="56" y="' + y + '" width="226" height="30" fill="none" stroke="#e0542b" stroke-width="1" rx="1"/>' +
          '<rect x="56" y="' + y + '" width="6" height="30" fill="#e0542b" opacity=".6"/>' +
          '<text x="72" y="' + (y+13) + '" font-size="10" fill="#f2693f" font-family="monospace" font-weight="bold">' + it[0] + '</text>' +
          '<text x="72" y="' + (y+24) + '" font-size="7.5" fill="#a39d90" font-family="monospace">' + it[1] + '</text>' +
          '<text x="276" y="' + (y+18) + '" text-anchor="end" font-size="7.5" fill="#7d7669" font-family="monospace">' + it[2] + '</text>' +
          (k < 3 ? '<line x1="169" y1="' + (y+30) + '" x2="169" y2="' + (y+42) + '" stroke="#e0542b" stroke-width=".6"/><path d="M166 ' + (y+38) + ' L169 ' + (y+42) + ' L172 ' + (y+38) + '" fill="#e0542b"/>' : '');
      }).join("")
    );
  }
  function artLayout() {
    var s = "";
    for (var k = 0; k < 9; k++) { s += spkr(44 + k * 26, 34); }
    [64,104,144].forEach(function (y) { s += spkr(26, y) + spkr(284, y); });
    for (var r = 0; r < 5; r++) { s += spkr(78 + r * 36, 198); }
    return bp('IMERZIVNÍ SÁL · ROZMÍSTĚNÍ', 'DWG-05',
      dimline(44, 26, 286, 26, 'FRONT · 9×') +
      '<rect x="46" y="62" width="228" height="122" fill="none" stroke="rgba(236,230,218,.18)" stroke-width="1" stroke-dasharray="5 3"/>' +
      '<line x1="46" y1="62" x2="274" y2="184" stroke="rgba(236,230,218,.06)"/><line x1="274" y1="62" x2="46" y2="184" stroke="rgba(236,230,218,.06)"/>' +
      '<text x="160" y="126" text-anchor="middle" font-size="9" fill="#a39d90" font-family="monospace" letter-spacing="2">HLEDIŠTĚ</text>' +
      s +
      leader(26, 104, 8, 104, 'L') + leader(284, 104, 304, 104, 'R') +
      '<text x="160" y="214" text-anchor="middle" font-size="8" fill="#f2693f" font-family="monospace">REAR · 5×</text>' +
      '<text x="160" y="232" text-anchor="middle" font-size="7" fill="#7d7669" font-family="monospace">Front + Side(L/R) + Rear · 1 procesor</text>'
    );
  }
  // ===== blueprint helpers =====
  function bp(title, code, inner) {
    return svg('0 0 320 248',
      '<defs><pattern id="bpgrid" width="16" height="16" patternUnits="userSpaceOnUse"><path d="M16 0 H0 V16" fill="none" stroke="rgba(224,84,43,.07)" stroke-width=".6"/></pattern></defs>' +
      '<rect x="6" y="6" width="308" height="236" fill="url(#bpgrid)" stroke="rgba(224,84,43,.3)" stroke-width="1"/>' +
      // corner ticks
      '<path d="M6 18 V6 H18 M302 6 H314 V18 M314 230 V242 H302 M18 242 H6 V230" fill="none" stroke="#e0542b" stroke-width="1.2"/>' +
      // title block
      '<line x1="6" y1="22" x2="314" y2="22" stroke="rgba(224,84,43,.3)" stroke-width=".8"/>' +
      '<text x="14" y="17" font-size="8" fill="#f2693f" font-family="monospace" letter-spacing="1.5">' + title + '</text>' +
      '<text x="306" y="17" text-anchor="end" font-size="7.5" fill="#7d7669" font-family="monospace">' + code + '</text>' +
      inner
    );
  }
  function svg(vb, inner) { return '<svg viewBox="' + vb + '" preserveAspectRatio="xMidYMid meet">' + inner + '</svg>'; }
  function ring(cx, cy, r) { return '<circle cx="' + cx + '" cy="' + cy + '" r="' + r + '" fill="none" stroke="rgba(224,84,43,.22)" stroke-width=".8" stroke-dasharray="2 5"/>'; }
  function dash(x1, y1, x2, y2) { return '<line x1="' + x1 + '" y1="' + y1 + '" x2="' + x2 + '" y2="' + y2 + '" stroke="rgba(224,84,43,.3)" stroke-width=".7" stroke-dasharray="2 3"/>'; }
  function spkr(x, y) {
    return '<g><rect x="' + x + '" y="' + y + '" width="16" height="12" fill="rgba(224,84,43,.1)" stroke="#e0542b" stroke-width="1.1"/>' +
      '<path d="M' + x + ' ' + y + ' L' + (x+16) + ' ' + (y+12) + ' M' + (x+16) + ' ' + y + ' L' + x + ' ' + (y+12) + '" stroke="#e0542b" stroke-width=".5"/></g>';
  }
  function tick(x, y) { return '<line x1="' + (x-3) + '" y1="' + y + '" x2="' + (x+3) + '" y2="' + y + '" stroke="#e0542b" stroke-width="1"/>'; }
  function dimline(x1, y, x2, yy, label) {
    return '<line x1="' + x1 + '" y1="' + y + '" x2="' + x2 + '" y2="' + y + '" stroke="#a39d90" stroke-width=".6"/>' +
      '<line x1="' + x1 + '" y1="' + (y-3) + '" x2="' + x1 + '" y2="' + (y+3) + '" stroke="#a39d90" stroke-width=".8"/>' +
      '<line x1="' + x2 + '" y1="' + (y-3) + '" x2="' + x2 + '" y2="' + (y+3) + '" stroke="#a39d90" stroke-width=".8"/>' +
      '<text x="' + ((x1+x2)/2) + '" y="' + (y-4) + '" text-anchor="middle" font-size="7.5" fill="#a39d90" font-family="monospace">' + label + '</text>';
  }
  function leader(x1, y1, x2, y2, label) {
    var ta = x2 >= x1 ? 'start' : 'end';
    var tx = x2 >= x1 ? x2 + 3 : x2 - 3;
    return '<line x1="' + x1 + '" y1="' + y1 + '" x2="' + x2 + '" y2="' + y2 + '" stroke="#7d7669" stroke-width=".6"/>' +
      '<circle cx="' + x1 + '" cy="' + y1 + '" r="1.5" fill="#f2693f"/>' +
      '<text x="' + tx + '" y="' + (y2+3) + '" text-anchor="' + ta + '" font-size="7.5" fill="#a39d90" font-family="monospace">' + label + '</text>';
  }
})();
